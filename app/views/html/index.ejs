<div class="card" style="text-align:center;padding:40px 30px;">
    <h1 style="font-size:32px;line-height:1.3;">HTML 在线预览</h1>
    <p style="font-size:15px;color:var(--text-desc);margin:12px 0 0;line-height:1.7;">
        粘贴任意 HTML 代码，即可生成一个纯净的预览页面。<br>
        页面原样展示、不做任何修改，支持 MathJax 等 CDN 外部库。
    </p>
</div>

<div class="card">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="success"><%= success %></div>
    <% } %>

    <form method="POST" action="/html">
        <label for="html">HTML 代码</label>
        <textarea id="html" name="html" rows="16" placeholder="&lt;div style='text-align:center;'&gt;&lt;h1&gt;你好，世界&lt;/h1&gt;&lt;/div&gt;" style="font-family:monospace;font-size:14px;" required></textarea>
        <div style="display:flex;gap:12px;align-items:center;margin-top:18px;flex-wrap:wrap;">
            <button type="submit" class="btn btn-primary">生成预览</button>
            <% if (typeof previewUrl !== 'undefined' && previewUrl) { %>
                <a href="<%= previewUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-success">打开预览</a>
                <code><%= previewUrl %></code>
            <% } %>
        </div>
    </form>
</div>

<div class="disclaimer">
    <strong>提示：</strong> 预览页面为匿名公开访问，任何获得预览地址的人都可以查看。请勿粘贴包含个人敏感信息的 HTML。
</div>
