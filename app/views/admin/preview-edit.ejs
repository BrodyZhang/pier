<div class="card" style="padding:20px 28px;">
    <div class="flex flex-wrap flex-between flex-center" style="gap:12px;">
        <div>
            <h1><%= type === 'html' ? '编辑 HTML 预览' : '编辑 Markdown 预览' %></h1>
            <a href="/admin/previews" style="font-size:13px;color:var(--text-muted);">← 返回预览管理</a>
        </div>
    </div>
</div>

<div class="card">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/previews/<%= type %>/<%= id %>/edit">
        <label for="content">内容</label>
        <textarea id="content" name="content" rows="20" spellcheck="false" style="font-family:monospace;font-size:13px;line-height:1.6;"><%= content %></textarea>
        <p style="font-size:12px;color:var(--text-muted);margin-top:4px;">修改后保存，预览页将立即使用新内容渲染。</p>

        <div style="margin-top:16px;">
            <button type="submit" class="btn btn-primary">保存修改</button>
            <a href="/admin/previews" class="btn btn-outline">取消</a>
        </div>
    </form>
</div>
